<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="Content-Security-Policy"
        content="default-src 'self';
                   script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdnjs.cloudflare.com;
                   style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://fonts.googleapis.com;
                   font-src https://fonts.gstatic.com;
                   img-src * data:;
                   connect-src https://api.github.com https://cdnjs.cloudflare.com;">
  <meta name="gist-public-id" content="7dff227af99c30472f2b1cdbf4839904">

  <title>Learning Wiki</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/github.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/codemirror.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/theme/material-darker.min.css">

  <style>
  :root{
    --bg:#ffffff;
    --bg-elevated:#f8f9fb;
    --bg-panel:#fbfbfc;
    --bg-sunken:#f3f4f6;
    --border:#e3e6ea;
    --border-soft:#edeff2;
    --text:#1c2126;
    --text-dim:#68707b;
    --text-faint:#9aa1ab;
    --wiki-accent: rgb(15 157 142);
    --wiki-accent-dim:rgba(15,157,142,.10);
    --play-accent:#7c4fe0;
    --play-accent-dim:rgba(124,79,224,.10);
    --accent:#0f9d8e;
    --accent-dim:rgba(15,157,142,.10);
    --danger:#dc2626;
    --danger-dim:rgba(220,38,38,.08);
    --ok:#16a34a;
    --warn:#d97706;
    --radius:10px;
    --radius-lg:16px;
    --page-bg:#eef0f3;
    --card-shadow:0 1px 2px rgba(16,24,40,.04), 0 4px 14px rgba(16,24,40,.05);
    --font-display:'Space Grotesk',sans-serif;
    --font-body:'Inter',sans-serif;
    --font-mono:'JetBrains Mono',monospace;
  }
  *{box-sizing:border-box;}
  html,body{height:100%;}
  body{
    margin:0;
    background:var(--page-bg);
    color:var(--text);
    font-family:var(--font-body);
    display:flex;
    flex-direction:column;
    overflow:hidden;
  }
  button{font-family:var(--font-body);cursor:pointer;}
  input,select,textarea{font-family:var(--font-body);}

  ::-webkit-scrollbar{width:9px;height:9px;}
  ::-webkit-scrollbar-thumb{background:#d6d9de;border-radius:6px;}
  ::-webkit-scrollbar-track{background:transparent;}

  /* ---------- TOPBAR ---------- */
  #topbar{
    display:flex;align-items:center;gap:14px;
    padding:10px 18px;
    margin:12px 12px 0 12px;
    background:var(--bg-elevated);
    border:1px solid var(--border);
    border-radius:var(--radius-lg);
    box-shadow:var(--card-shadow);
    flex-shrink:0;
    z-index:20;
  }
  #brand{
    display:flex;align-items:center;gap:9px;
    font-family:var(--font-display);font-weight:600;font-size:15px;
    letter-spacing:.2px;
    white-space:nowrap;
    color:var(--text);
  }
  #brand .dot{
    width:9px;height:9px;border-radius:50%;
    background:linear-gradient(135deg, var(--wiki-accent), var(--play-accent));
    flex-shrink:0;
  }
  #hamburger{
    background:none;border:1px solid var(--border);color:var(--text);
    border-radius:8px;width:34px;height:34px;
    align-items:center;justify-content:center;
    font-size:16px;display:flex;
  }
  #mobile-bottom-nav{display:none;}
  #topbar-spacer{flex:1;}
  #sync-status{
    display:flex;align-items:center;gap:7px;
    font-size:12px;color:var(--text-dim);
    padding:6px 10px;border:1px solid var(--border);border-radius:8px;
    white-space:nowrap;cursor:pointer;
  }
  #sync-status:hover{border-color: rgb(155 157 156 / 0.49);color:var(--text);}
  #sync-status:focus-visible{outline:2px solid var(--wiki-accent);outline-offset:2px;}
  #sync-status .pulse{width:7px;height:7px;border-radius:50%;background:var(--text-faint);}
  #sync-status.status-synced .pulse{background:var(--ok);}
  #sync-status.status-syncing .pulse{background:var(--warn);animation:pulse 1s infinite;}
  @keyframes pulse{0%,100%{opacity:1;}50%{opacity:.3;}}

  /* ---- VIEWER / ADMIN MODE SWITCH ---- */
  #mode-switch{
    position:relative;display:inline-flex;align-items:center;
    background:var(--bg-sunken);
    border:1px solid var(--border);
    border-radius:999px;
    padding:3px;gap:0;flex-shrink:0;
    user-select:none;
  }
  #mode-switch .knob{
    position:absolute;top:3px;bottom:3px;left:3px;
    width:calc(50% - 3px);
    border-radius:999px;
    background:var(--bg);
    box-shadow:0 1px 3px rgba(16,24,40,.12);
    transition:transform .18s ease, background .18s ease, box-shadow .18s ease;
    pointer-events:none;
  }
  #mode-switch.admin .knob{
    transform:translateX(100%);
    background:rgba(22,163,74,.14);
    box-shadow:inset 0 0 0 1px rgba(22,163,74,.3);
  }
  #mode-switch .mode-opt{
    position:relative;z-index:1;
    background:none;border:none;
    min-width:62px;text-align:center;
    font-size:11.5px;font-weight:700;letter-spacing:.3px;
    padding:4px 10px;border-radius:999px;
    color:var(--text-faint);
    transition:color .15s;white-space:nowrap;
  }
  #mode-switch .mode-opt:hover:not(.active){color:var(--text);}
  #mode-switch .mode-opt.active{color:var(--text-dim);}
  #mode-switch.admin .mode-opt.active{color:var(--ok);}
  #mode-switch .mode-opt:focus-visible{outline:2px solid var(--accent);outline-offset:2px;}

  /* in viewer mode nascondi i controlli di editing */
  body.viewer-mode #btn-new-category,
  body.viewer-mode #footer-actions-row,
  body.viewer-mode .footer-divider,
  body.viewer-mode #btn-toggle-edit,
  body.viewer-mode #btn-delete-file,
  body.viewer-mode #file-cat-select,
  body.viewer-mode .del-cat,
  body.viewer-mode #btn-empty-upload{ display:none !important; }

  body.viewer-mode #file-title-input{
    pointer-events:none;
    opacity:.85;
  }
  body.viewer-mode #wiki-empty p .upload-hint{ display:none; }

  /* ---------- LAYOUT: 3 COLONNE (a card, spaziate) ---------- */
  #app{flex:1;display:flex;min-height:0;position:relative;padding:12px 12px 12px 12px;gap:0;}

  /* ---- SIDEBAR ---- */
  #wiki-sidebar{
    --accent:var(--wiki-accent); --accent-dim:var(--wiki-accent-dim);
    width:252px;flex-shrink:0;
    background:var(--bg-panel);
    border:1px solid var(--border);
    border-radius:var(--radius-lg);
    box-shadow:var(--card-shadow);
    display:flex;flex-direction:column;
    min-height:0;overflow:hidden;
    margin-right:12px;
    transition:width .18s ease, margin .18s ease, opacity .15s ease;
  }
  #wiki-sidebar.collapsed{width:0;min-width:0;margin-right:0;border:none;box-shadow:none;overflow:hidden;opacity:0;}
  #sidebar-head{
    display:flex;align-items:center;gap:8px;
    padding:13px 14px 8px;flex-shrink:0;
  }
  #sidebar-head .label{
    font-family:var(--font-display);font-weight:600;font-size:13px;color:var(--text);
    display:flex;align-items:center;gap:7px;flex:1;
  }
  #sidebar-head .label svg{color:var(--accent);flex-shrink:0;}
  #btn-collapse-sidebar{
    background:none;border:1px solid var(--border);color:var(--text-faint);
    width:26px;height:26px;border-radius:7px;flex-shrink:0;
    display:flex;align-items:center;justify-content:center;
  }
  #btn-collapse-sidebar:hover{color:var(--text);border-color:var(--text-faint);}
  #wiki-search{padding:0 14px 10px;}
  #wiki-search input{
    width:100%;background:var(--bg);border:1px solid var(--border);
    color:var(--text);border-radius:8px;padding:8px 10px;font-size:13px;outline:none;
  }
  #wiki-search input:focus{border-color:var(--accent);}
  #category-list{flex:1;overflow-y:auto;padding:4px 10px;}
  .category-block{margin-bottom:2px;}
  .category-head{
    display:flex;
    align-items:center;
    gap:7px;
    padding:8px 8px;
    border-radius:9px;cursor:pointer;
    font-size:10px;font-weight:700;color:var(--text-dim);
    text-transform:uppercase;letter-spacing:.5px;
  }
  .category-head svg{flex-shrink:0;color:var(--text-faint);}
  .category-head:hover{background:var(--bg-sunken);}
  .category-head .chev{font-size:10px;transition:transform .15s;width:10px;display:inline-block;color:var(--text-faint);}
  .category-head.collapsed .chev{transform:rotate(-90deg);}
  .category-head .count{
    margin-left:auto;font-weight:600;font-size:10.5px;color:var(--text-faint);
    font-family:var(--font-mono);background:var(--bg-sunken);
    padding:1px 6px;border-radius:20px;
  }
  .category-head .del-cat{opacity:0;color:var(--text-faint);padding:2px 4px;border-radius:4px;display:flex;}
  .category-head:hover .del-cat{opacity:1;}
  .category-head .del-cat:hover{color:var(--danger);}

  .file-list{padding-left:8px;}
  .file-item{
    display:flex;align-items:center;gap:8px;
    padding:7px 10px;border-radius:9px;cursor:pointer;
    font-size:13px;color:var(--text-dim);
    margin:1px 0;
  }
  .recent-block{
    margin:0 0 8px;
    padding-bottom:8px;
    border-bottom:1px solid var(--border-soft);
  }
  .recent-block .category-head{cursor:default;}
  .recent-block .category-head:hover{background:transparent;}
  .recent-files{padding-left:8px;}
  .recent-files .file-category{
    overflow:hidden;
    color:var(--text-faint);
    font-size:10px;
    font-weight:600;
    text-overflow:ellipsis;
    white-space:nowrap;
  }
  .file-item svg{flex-shrink:0;color:var(--text-faint);}
  .file-item:hover{background:var(--bg-sunken);color:var(--text);}
  .file-item.active{background:var(--accent-dim);color:var(--accent);font-weight:600;}
  .file-item.active svg{color:var(--accent);}
  .file-item .fname{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1;}
  #wiki-sidebar-footer{padding:10px 10px 12px;border-top:1px solid var(--border-soft);display:flex;flex-direction:column;gap:6px;flex-shrink:0;}
  #wiki-sidebar-footer .footer-divider{height:1px;background:var(--border-soft);margin:2px 2px;}
  .side-btn{
    background:var(--bg);border:1px solid var(--border);color:var(--text);
    border-radius:9px;padding:8px 10px;font-size:12.5px;font-weight:500;
    display:flex;align-items:center;gap:7px;justify-content:center;
  }
  .side-btn svg{flex-shrink:0;}
  .side-btn:hover{border-color:var(--accent);color:var(--accent);}
  .side-btn:disabled{opacity:.4;cursor:not-allowed;}
  .side-btn:disabled:hover{border-color:var(--border);color:var(--text);}
  .side-btn.subtle{background:transparent;border-color:transparent;color:var(--text-dim);}
  .side-btn.subtle:hover{background:var(--bg-sunken);border-color:transparent;color:var(--text);}
  #footer-actions-row{display:flex;gap:6px;}
  #footer-actions-row .side-btn{flex:1;padding:8px 4px;flex-direction:column;gap:3px;}
  #footer-actions-row .side-btn .btn-label{
    font-size:9.5px;font-weight:600;letter-spacing:.2px;
    color:inherit;line-height:1;
  }


  /* ---- DOC PANEL (centro) ---- */
  #doc-panel{
    --accent:var(--wiki-accent); --accent-dim:var(--wiki-accent-dim);
    flex:1 1 40%;min-width:340px;
    display:flex;flex-direction:column;min-height:0;
    background:var(--bg);
    border:1px solid var(--border);
    border-radius:var(--radius-lg);
    box-shadow:var(--card-shadow);
    overflow:hidden;
  }
  #wiki-empty{
    flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;
    color:var(--text-faint);gap:10px;text-align:center;padding:20px;
  }
  #wiki-empty h2{font-family:var(--font-display);color:var(--text-dim);font-weight:600;font-size:18px;margin:0;}
  #wiki-empty p{font-size:13px;max-width:340px;margin:0;line-height:1.5;}

  #file-panel{flex:1;display:none;flex-direction:column;min-height:0;}
  #file-panel.active{display:flex;}
  #file-header{
    display:flex;align-items:center;gap:10px;flex-wrap:wrap;
    padding:14px 20px;border-bottom:1px solid var(--border-soft);
    background:var(--bg-elevated);
  }
  #file-title-input{
    background:transparent;border:none;color:var(--text);
    font-family:var(--font-display);font-size:16px;font-weight:600;
    outline:none;flex:1;min-width:120px;padding:4px 2px;border-radius:5px;
  }
  #file-title-input:focus{background:var(--bg);}
  .category-picker{
    position:relative;flex-shrink:0;
  }
  .category-picker-toggle{
    /*min-width:148px;*/
    height:30px;
    display:flex;
    align-items:center;
    gap:8px;
    padding:0 10px 0 11px;
    background:var(--bg);border:1px solid var(--border);
    border-radius:9px;color:var(--text-dim);
    font-size:12.5px;font-weight:600;
    transition:border-color .15s ease, box-shadow .15s ease, color .15s ease, background .15s ease;
  }
  .category-picker-toggle:hover{
    color:var(--text);border-color:#c8cdd4;background:#fff;
  }
  .category-picker.open .category-picker-toggle{
    color:var(--wiki-accent);border-color:var(--wiki-accent);
    box-shadow:0 0 0 3px var(--wiki-accent-dim);
  }
  .category-picker-toggle .category-icon{color:var(--wiki-accent);flex-shrink:0;}
  .category-picker-toggle .category-label{
    overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1;text-align:left;
  }
  .category-picker-toggle .chev-down{
    color:var(--text-faint);flex-shrink:0;transition:transform .18s ease;
  }
  .category-picker.open .category-picker-toggle .chev-down{transform:rotate(180deg);}
  .category-dropdown{
    position:absolute;top:calc(100% + 7px);right:0;z-index:55;
    min-width:220px;max-width:280px;
    display:none;flex-direction:column;gap:2px;
    padding:6px;background:var(--bg);
    border:1px solid var(--border);border-radius:12px;
    box-shadow:0 14px 32px rgba(16,24,40,.14);
  }
  .category-picker.open .category-dropdown{display:flex;}
  .category-option{
    width:100%;display:flex;align-items:center;gap:9px;
    padding:9px 10px;background:transparent;border:none;border-radius:8px;
    color:var(--text-dim);font-size:13px;font-weight:500;text-align:left;
  }
  .category-option:hover{background:var(--bg-sunken);color:var(--text);}
  .category-option.selected{
    background:var(--wiki-accent-dim);color:var(--wiki-accent);font-weight:600;
  }
  .category-option .option-name{
    overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1;
  }
  .category-option .check{color:var(--wiki-accent);flex-shrink:0;}
  .icon-btn{
    background:var(--bg);border:1px solid var(--border);color:var(--text-dim);
    border-radius:7px;padding:6px 11px;font-size:12px;font-weight:500;
    display:flex;align-items:center;gap:5px;
  }
  .icon-btn:hover{color:var(--text);border-color:var(--text-faint);}
  .icon-btn.danger:hover{color:var(--danger);border-color:var(--danger);background:var(--danger-dim);}
  .icon-btn.accent{color:#fff;background:var(--accent);border-color:var(--accent);}
  .icon-btn.accent:hover{opacity:.9;color:#fff;}

  /* ---- MENU AZIONI (dropdown nel file-header) ---- */
  #file-actions-menu{position:relative;display:inline-flex;}
  /* nascondi il menu Azioni in viewer mode (solo admin) */
  body.viewer-mode #file-actions-menu{ display:none !important; }
  #btn-actions-toggle{
    display:flex;align-items:center;gap:6px;
  }
  #btn-actions-toggle .chev-down{
    transition:transform .15s;
  }
  #file-actions-menu.open #btn-actions-toggle .chev-down{
    transform:rotate(180deg);
  }
  #actions-dropdown{
    position:absolute;top:calc(100% + 6px);right:0;z-index:50;
    min-width:170px;
    background:var(--bg);
    border:1px solid var(--border);
    border-radius:10px;
    box-shadow:0 10px 30px rgba(16,24,40,.14);
    padding:6px;
    display:none;flex-direction:column;gap:2px;
  }
  #file-actions-menu.open #actions-dropdown{display:flex;}
  .actions-item{
    display:flex;align-items:center;gap:10px;
    background:none;border:none;text-align:left;
    padding:8px 10px;border-radius:7px;
    font-size:13px;font-weight:500;color:var(--text);
    width:100%;
  }
  .actions-item svg{flex-shrink:0;color:var(--text-dim);}
  .actions-item:hover{background:var(--bg-sunken);}
  .actions-item.danger{color:var(--danger);}
  .actions-item.danger svg{color:var(--danger);}
  .actions-item.danger:hover{background:var(--danger-dim);}

  #file-body{flex:1;overflow-y:auto;min-height:0;}
  #md-viewer{padding:24px 30px;max-width:760px;margin:0 auto;line-height:1.7;font-size:15px;}
  #md-editor{
    width:100%;height:100%;border:none;outline:none;resize:none;
    background:var(--bg);color:var(--text);
    font-family:var(--font-mono);font-size:13.5px;line-height:1.6;
    padding:20px 26px;display:none;
  }
  #md-editor.active{display:block;}
  #md-viewer.hidden{display:none;}

  #md-viewer h1,#md-viewer h2,#md-viewer h3{font-family:var(--font-display);color:var(--text);}
  #md-viewer h1{font-size:24px;border-bottom:1px solid var(--border);padding-bottom:8px;margin-top:0;}
  #md-viewer h2{font-size:19px;margin-top:30px;border-bottom:1px solid var(--border-soft);padding-bottom:6px;}
  #md-viewer h3{font-size:15.5px;margin-top:24px;}
  #md-viewer p{color:#333a42;}
  #md-viewer a{color:var(--accent);}
  #md-viewer code{
    background:var(--bg-sunken);border:1px solid var(--border-soft);
    padding:2px 5px;border-radius:5px;font-family:var(--font-mono);font-size:.85em;
  }
  #md-viewer pre{
    background:#fff;
    padding:14px 16px;
    overflow-x:auto;
  }
  #md-viewer pre code{background:none;border:none;padding:0;}
  #md-viewer blockquote{
    border-left:3px solid var(--accent);margin:0;padding:2px 16px;color:var(--text-dim);
    background:var(--accent-dim);border-radius:0 6px 6px 0;
  }
  #md-viewer ul,#md-viewer ol{color:#333a42;padding-left:22px;}
  #md-viewer table{border-collapse:collapse;width:100%;margin:14px 0;}
  #md-viewer th,#md-viewer td{border:1px solid var(--border);padding:6px 10px;font-size:13.5px;}
  #md-viewer th{background:var(--bg-sunken);}
  #md-viewer img{max-width:100%;border-radius:8px;}
  #md-viewer hr{border:none;border-top:1px solid var(--border);margin:24px 0;}

  /* ---- "Prova questo esempio" nei code block ---- */
  .code-example-wrap{
    margin:20px 0;
    overflow:hidden;
    border:0.5px solid #d9dce5;
    border-radius:12px;
    background: rgba(241, 242, 247, 0.73);
  }
  .code-example-wrap pre{
    margin:0;
    padding:16px 0;
    overflow-x:auto;
    border:none;
    border-radius:0;
    background:#eef0f4;
    box-shadow:inset 0 1px 0 rgba(255,255,255,.72);
  }
  .code-example-wrap pre code{
    display:block;
    min-width:max-content;
    padding:0;
    border:none;
    background:transparent;
    counter-reset:code-line;
    font-size:12.5px;
    line-height:1.75;
  }
  .code-example-wrap .code-line{
    display:block;
    min-height:1.75em;
    padding:0 18px 0 58px;
    position:relative;
  }
  .code-example-wrap .code-line::before{
    content:counter(code-line);
    counter-increment:code-line;
    position:absolute;
    top:0;
    left:0;
    width:38px;
    padding-right:10px;
    color:#b0b7c1;
    font-family:var(--font-mono);
    font-size:10.5px;
    text-align:right;
    user-select:none;
  }
  .code-example-header{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:12px;
    min-height:48px;
    padding:8px 10px 8px 14px;
    border-bottom:1px solid #d9dce5;
    box-shadow:inset 0 1px 0 rgba(255,255,255,.95);
  }
  .code-example-meta{
    display:flex;
    align-items:center;
    gap:8px;
    min-width:0;
  }
  .code-example-meta::before{
    content:"";
    width:8px;
    height:8px;
    flex-shrink:0;
    border-radius:50%;
    background:var(--play-accent);
    box-shadow:0 0 0 4px var(--play-accent-dim);
  }
  .code-example-header .lang-label{
    color:var(--play-accent);
    font-family:var(--font-mono);
    font-size:10.5px;
    font-weight:600;
    letter-spacing:.6px;
    text-transform:uppercase;
  }
  .code-example-header .example-kind{
    overflow:hidden;
    color: var(--text-dim);
    font-size:11.5px;
    font-weight:500;
    text-overflow:ellipsis;
    white-space:nowrap;
  }
  .code-example-actions{
    display:flex;
    align-items:center;
    gap:6px;
    flex-shrink:0;
  }
  .copy-example-btn,
  .try-example-btn{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    gap:6px;
    min-height:30px;
    border-radius:8px;
    font-size:11.5px;
    font-weight:600;
    white-space:nowrap;
    transition:background .16s ease,border-color .16s ease,color .16s ease,transform .16s ease;
  }
  .copy-example-btn{
    padding:0 9px;
    border:1px solid transparent;
    background:transparent;
    color:var(--text-dim);
  }
  .copy-example-btn:hover{
    background:var(--bg-sunken);
    border-color:var(--border);
    color:var(--text);
  }
  .copy-example-btn.copied{
    color:var(--ok);
  }
  .try-example-btn{
    padding:0 11px;
    border:1px solid var(--play-accent);
    background:var(--play-accent);
    color:#fff;
    box-shadow:0 1px 2px rgba(124,79,224,.2);
  }
  .try-example-btn:hover{
    background:#6940ce;
    border-color:#6940ce;
    transform:translateY(-1px);
  }
  .copy-example-btn:focus-visible,
  .try-example-btn:focus-visible{
    outline:2px solid var(--play-accent);
    outline-offset:2px;
  }
  #playground-panel.flash{
    box-shadow:inset 0 0 0 2px var(--play-accent),var(--card-shadow);
    transition:box-shadow .2s ease;
  }

  /* ---- RESIZER ---- */
  #resizer{
    width:14px;flex-shrink:0;cursor:col-resize;background:transparent;position:relative;
  }
  #resizer::before{
    content:"";position:absolute;top:0;bottom:0;left:50%;transform:translateX(-50%);
    width:4px;border-radius:4px;background:transparent;transition:background .15s;
  }
  #resizer:hover::before, #resizer.dragging::before{background:var(--border);}
  #resizer::after{
    content:"";position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);
    width:2px;height:22px;background:var(--text-faint);border-radius:2px;
  }

  /* ---- PLAYGROUND (destra) — tema scuro dedicato ---- */
  #playground-panel{
    --accent:var(--play-accent); --accent-dim:rgba(167,139,250,.16);
    --pg-bg:#0d1117; --pg-bg-elevated:#161b22; --pg-border:#2a323c;
    --pg-text:#e6edf3; --pg-text-dim:#8b96a3; --pg-text-faint:#5c6773;
    width:38%;min-width:320px;flex-shrink:0;
    display:flex;flex-direction:column;min-height:0;
    background:var(--pg-bg);color:var(--pg-text);
    border:1px solid var(--pg-border);
    border-radius:var(--radius-lg);
    box-shadow:var(--card-shadow);
    overflow:hidden;
  }
  #playground-panel .icon-btn{
    background:var(--pg-bg-elevated);border:1px solid var(--pg-border);color:var(--pg-text-dim);
  }
  #playground-panel .icon-btn:hover{color:var(--pg-text);border-color:var(--pg-text-faint);}
  #playground-panel .icon-btn.accent{color:#fff;background:#8f5cf0;border-color:#8f5cf0;}
  #pg-toolbar{
    display:flex;align-items:center;gap:8px;
    padding:10px 14px;border-bottom:1px solid var(--pg-border);
    background:var(--pg-bg-elevated);flex-shrink:0;
  }
  #pg-toolbar .spacer{flex:1;}
  #pg-autosave{font-size:11px;color:var(--pg-text-faint);font-family:var(--font-mono);}
  #pg-split{flex:1;display:flex;flex-direction:column;min-height:0;}
  #pg-editor-wrap{flex:1 1 55%;min-height:80px;display:flex;flex-direction:column;border-bottom:none;}
  #pg-editor-wrap .CodeMirror{flex:1;height:100%;font-family:var(--font-mono);font-size:12.5px;}
  #pg-split-resizer{
    height:12px;flex-shrink:0;cursor:row-resize;position:relative;
    background:var(--pg-bg-elevated);touch-action:none;
  }
  #pg-split-resizer::before{
    content:"";position:absolute;left:0;right:0;top:50%;height:3px;
    transform:translateY(-50%);background:transparent;
    transition:background .15s ease;
  }
  #pg-split-resizer::after{
    content:"";position:absolute;left:50%;top:50%;width:28px;height:2px;
    transform:translate(-50%,-50%);border-radius:2px;background:var(--pg-text-faint);
  }
  #pg-split-resizer:hover::before,
  #pg-split-resizer.dragging::before{background:var(--play-accent);}
  #pg-preview-wrap{flex:1 1 45%;min-height:80px;display:flex;flex-direction:column;background:var(--pg-bg);}
  #pg-iframe{flex:1;border:none;width:100%;background:var(--pg-bg);}
  #pg-console{
    height:100px;flex-shrink:0;background:#0a0e13;border-top:1px solid var(--pg-border);
    color:var(--pg-text);font-family:var(--font-mono);font-size:11.5px;overflow-y:auto;
    padding:8px 12px;display:none;
  }
  #pg-console.visible{display:block;}
  #pg-console .log-line{padding:2px 0;border-bottom:1px solid #1c232b;color:#c9d1d9;}
  #pg-console .log-line.error{color:#ff7b72;}

  /* ---------- MOBILE ---------- */
  #mobile-bottom-nav{
    display:none;
    position:fixed;left:0;right:0;bottom:0;z-index:40;
    background:var(--bg-elevated);border-top:1px solid var(--border);
    padding:6px 10px calc(6px + env(safe-area-inset-bottom));
    gap:6px;
  }
  #mobile-bottom-nav button{
    flex:1;background:none;border:none;color:var(--text-faint);
    display:flex;flex-direction:column;align-items:center;gap:3px;
    padding:6px 4px;border-radius:10px;font-size:10.5px;font-weight:600;
  }
  #mobile-bottom-nav button.active{color:var(--wiki-accent);background:var(--wiki-accent-dim);}
  #mobile-bottom-nav button[data-target="playground"].active{color:var(--play-accent);background:var(--play-accent-dim);}
  #mobile-bottom-nav button svg{flex-shrink:0;}

  @media (max-width:980px){
    #app{padding:8px;}
    #topbar{margin:8px 8px 0 8px;}
    #mobile-bottom-nav{display:flex;}
    #wiki-sidebar{
      position:fixed;left:8px;top:70px;bottom:78px;z-index:30;width:84%;max-width:320px;
      margin:0;
      transform:translateX(-115%);transition:transform .2s ease;
      box-shadow:0 10px 30px rgba(0,0,0,.18);
    }
    #wiki-sidebar.open{transform:translateX(0);}
    #wiki-sidebar.collapsed{width:84%;max-width:320px;opacity:1;}
    #sidebar-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.35);z-index:25;}
    #sidebar-overlay.visible{display:block;}
    #resizer{display:none;}
    #doc-panel,#playground-panel{width:100% !important;display:none;margin-bottom:70px;}
    #doc-panel.mobile-active,#playground-panel.mobile-active{display:flex;}
    #brand span.full{display:none;}
    .code-example-header{align-items:flex-start;padding:10px;}
    .code-example-meta{padding:5px 2px;}
    .code-example-header .example-kind{display:none;}
    .copy-example-btn{width:30px;padding:0;}
    .copy-example-btn .btn-text{display:none;}
    .try-example-btn{padding:0 9px;}
    .try-example-btn .btn-text{font-size:0;}
    .try-example-btn .btn-text::after{content:"Prova";font-size:11.5px;}
    .code-example-wrap .code-line{padding-left:48px;padding-right:14px;}
    .code-example-wrap .code-line::before{width:31px;padding-right:7px;}
  }

  /* ---------- MODAL ---------- */
  .modal-overlay{
    position:fixed;inset:0;background:rgba(20,22,25,.4);
    display:none;align-items:center;justify-content:center;z-index:100;padding:20px;
  }
  .modal-overlay.visible{display:flex;}
  .modal{
    background:var(--bg);border:1px solid var(--border);
    border-radius:14px;padding:24px;width:100%;max-width:420px;
    max-height:85vh;overflow-y:auto;box-shadow:0 20px 50px rgba(0,0,0,.15);
  }
  .modal h3{font-family:var(--font-display);margin:0 0 4px;font-size:17px;}
  .modal p.hint{color:var(--text-dim);font-size:12.5px;line-height:1.5;margin:4px 0 16px;}
  .modal label{display:block;font-size:12px;color:var(--text-dim);margin:12px 0 5px;font-weight:500;}
  .modal input[type=text],.modal input[type=password]{
    width:100%;background:var(--bg);border:1px solid var(--border);
    color:var(--text);border-radius:8px;padding:9px 10px;font-size:13px;outline:none;
  }
  .modal input:focus{border-color:var(--accent);}
  .modal-actions{display:flex;gap:8px;margin-top:20px;justify-content:flex-end;}
  .btn-primary{background:var(--wiki-accent);border:none;color:#fff;font-weight:600;padding:9px 16px;border-radius:8px;font-size:13px;}
  .btn-secondary{background:transparent;border:1px solid var(--border);color:var(--text-dim);padding:9px 16px;border-radius:8px;font-size:13px;}
  .modal a{color:var(--wiki-accent);}
  #settings-status-msg{font-size:12px;margin-top:10px;min-height:16px;}

  /* ---- Autocompletamento Playground (tema scuro) ---- */
  li.CodeMirror-hint-active{
    background:#8f5cf0;
    color:#fff;
  }

  /* ---- Ghost text (completamento inline grigio) ---- */
  .pg-ghost-text{
    color:#5c6773;
    opacity:.75;
    font-style:normal;
    pointer-events:none;
  }

</style>
</head>
<body>

<div id="topbar">
  <button id="hamburger" title="Menu">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="4" y1="7" x2="20" y2="7"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="17" x2="20" y2="17"/></svg>
  </button>
  <div id="brand"><span class="dot"></span><span class="full">Learning Wiki</span></div>
  <div id="mode-switch" class="viewer" role="group" aria-label="Modalità" title="Cambia modalità">
    <span class="knob"></span>
    <button type="button" class="mode-opt active" data-mode="viewer" aria-pressed="true">Viewer</button>
    <button type="button" class="mode-opt" data-mode="admin" aria-pressed="false">Admin</button>
  </div><div id="topbar-spacer"></div>
  <div id="sync-status" class="status-idle" title="Apri impostazioni sincronizzazione"
       role="button" tabindex="0" aria-label="Apri impostazioni sincronizzazione">
    <span class="pulse"></span><span id="sync-status-text">non configurato</span>
  </div>
</div>

<div id="app">
  <div id="sidebar-overlay"></div>

  <!-- SIDEBAR: TOPIC -->
  <div id="wiki-sidebar">
    <div id="sidebar-head">
      <span class="label">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
        Argomenti
      </span>
      <button id="btn-collapse-sidebar" title="Comprimi sidebar">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><line x1="9" y1="4" x2="9" y2="20"/></svg>
      </button>
    </div>
    <div id="wiki-search"><input type="text" id="wiki-search-input" placeholder="Cerca file..."></div>
    <div id="category-list"></div>
    <div id="wiki-sidebar-footer">
      <button class="side-btn" id="btn-new-category">
        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Nuova categoria
      </button>
      <input type="file" id="file-input-md" accept=".md,.markdown,text/markdown" multiple style="display:none;">
      <div class="footer-divider"></div>
      <div id="footer-actions-row">
        <button class="side-btn icon-only" id="btn-upload-md" title="Carica file .md">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12"/><polyline points="7 8 12 3 17 8"/><path d="M5 21h14"/></svg>
          <span class="btn-label">Carica</span>
        </button>
        <button class="side-btn icon-only subtle" id="btn-export-current" disabled title="Esporta file corrente">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><path d="M12 15V3"/></svg>
          <span class="btn-label">Download</span>
        </button>
        <button class="side-btn icon-only subtle" id="btn-export-all" title="Esporta tutti i file">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8l-9-5-9 5v8l9 5 9-5z"/><path d="M3.3 8.5l8.7 5 8.7-5"/><path d="M12 21.5V13"/></svg>
          <span class="btn-label">Export</span>
        </button>
      </div>
    </div>
  </div>

  <!-- CENTRO: DOCUMENTAZIONE -->
  <div id="doc-panel" class="mobile-active">
    <div id="wiki-empty">
      <h2>Nessun file selezionato</h2>
      <p>Seleziona un argomento dalla sidebar per iniziare a leggere.</p>
      <p class="upload-hint" style="font-size:12px;color:var(--text-faint);margin-top:4px;">
        In modalità Admin puoi caricare nuovi file .md.
      </p>
      <button class="side-btn" id="btn-empty-upload" style="margin-top:6px;">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12"/><polyline points="7 8 12 3 17 8"/><path d="M5 21h14"/></svg>
        Carica file .md
      </button>
    </div>
    <div id="file-panel">
      <div id="file-header">
        <input type="text" id="file-title-input" placeholder="Titolo file">
        <div id="file-category-picker" class="category-picker">
          <button class="category-picker-toggle" id="btn-category-toggle" type="button"
                  aria-haspopup="listbox" aria-expanded="false" aria-label="Cambia categoria">
            <svg class="category-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
            </svg>
            <span class="category-label" id="category-label">Categoria</span>
            <svg class="chev-down" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          </button>
          <div id="category-dropdown" class="category-dropdown" role="listbox" aria-label="Categorie"></div>
        </div>
        <div id="file-actions-menu">
          <button class="icon-btn" id="btn-actions-toggle" aria-haspopup="true" aria-expanded="false">
            Azioni
            <svg class="chev-down" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div id="actions-dropdown" role="menu">
            <button class="actions-item" id="btn-toggle-edit" role="menuitem">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
              Modifica
            </button>
            <button class="actions-item danger" id="btn-delete-file" role="menuitem">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/></svg>
              Elimina
            </button>
          </div>
        </div>
      </div>
      <div id="file-body">
        <div id="md-viewer"></div>
        <textarea id="md-editor" spellcheck="false"></textarea>
      </div>
    </div>
  </div>

  <div id="resizer"></div>

  <!-- DESTRA: PLAYGROUND -->
  <div id="playground-panel">
    <div id="pg-toolbar">
      <button class="icon-btn accent" id="btn-run">
        <svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg>
        Run
      </button>
      <button class="icon-btn" id="btn-reset">
        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
        Reset
      </button>
      <button class="icon-btn" id="btn-toggle-console">
        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg>
        Console
      </button>
      <div class="spacer"></div>
      <span id="pg-autosave">—</span>
    </div>
    <div id="pg-split">
      <div id="pg-editor-wrap">
        <div style="padding:4px 12px; font-size:10px; color:var(--pg-text-faint);
        font-family:var(--font-mono); background:var(--pg-bg-elevated);
        border-bottom:1px solid var(--pg-border); letter-spacing:.5px;">
          EDITOR
        </div>
        <textarea id="pg-textarea"></textarea>
      </div>

      <div id="pg-split-resizer" role="separator" aria-label="Ridimensiona editor e anteprima"></div>

      <div id="pg-preview-wrap">
        <div style="padding:4px 12px; font-size:10px; color:var(--pg-text-faint);
        font-family:var(--font-mono); background:var(--pg-bg);
        border-bottom:1px solid var(--pg-border); letter-spacing:.5px;">
          PREVIEW
        </div>
        <iframe id="pg-iframe" sandbox="allow-scripts"></iframe>
      </div>
    </div>
    <div id="pg-console"></div>
  </div>
</div>

<div id="mobile-bottom-nav">
  <button id="btn-mobile-doc" class="active" data-target="doc">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
    Documentazione
  </button>
  <button id="btn-mobile-pg" data-target="playground">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5"><ellipse cx="12" cy="12" rx="10" ry="4.2"/><ellipse cx="12" cy="12" rx="10" ry="4.2" transform="rotate(60 12 12)"/><ellipse cx="12" cy="12" rx="10" ry="4.2" transform="rotate(120 12 12)"/><circle cx="12" cy="12" r="1.6" fill="currentColor"/></svg>
    Playground
  </button>
</div>

<!-- SETTINGS MODAL -->
<div class="modal-overlay" id="settings-modal">
  <div class="modal">
    <h3>Impostazioni sincronizzazione</h3>
    <p class="hint">Learning Wiki salva i tuoi file e il codice del Playground in un
      <a href="https://gist.github.com" target="_blank" rel="noopener">Gist GitHub</a> privato, così restano sincronizzati
      tra dispositivi (e dentro Notion). Serve un token con permesso "gist":
      <a href="https://github.com/settings/tokens/new?scopes=gist&description=Learning%20Wiki" target="_blank" rel="noopener">crealo qui</a>
      (lo scope "gist" è già preselezionato), copialo qui sotto, poi premi "Crea nuovo Gist" per generarne
      uno automaticamente — oppure incolla l'ID/URL di un Gist esistente.</p>
    <label for="input-github-token">GitHub Token (scope "gist")</label>
    <input type="password" id="input-github-token" placeholder="ghp_...">
    <label for="input-gist-id">Gist ID (o URL)</label>
    <input type="text" id="input-gist-id" placeholder="generato automaticamente...">
    <div id="settings-status-msg"></div>
    <div class="modal-actions">
      <button class="btn-secondary" id="btn-close-settings">Chiudi</button>
      <button class="btn-secondary" id="btn-init-bin">Crea nuovo Gist</button>
      <button class="btn-primary" id="btn-save-settings">Salva</button>
    </div>
  </div>
</div>

<!-- NEW CATEGORY MODAL -->
<div class="modal-overlay" id="category-modal">
  <div class="modal">
    <h3>Nuova categoria</h3>
    <label for="input-new-category">Nome categoria</label>
    <input type="text" id="input-new-category" placeholder="es. React">
    <div class="modal-actions">
      <button class="btn-secondary" id="btn-cancel-category">Annulla</button>
      <button class="btn-primary" id="btn-confirm-category">Crea</button>
    </div>
  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/marked/4.3.0/marked.min.js" integrity="sha512-..." crossorigin="anonymous"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/dompurify/3.0.9/purify.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/codemirror.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/mode/xml/xml.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/mode/javascript/javascript.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/mode/jsx/jsx.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/addon/edit/closebrackets.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/addon/edit/matchbrackets.min.js"></script>

<script>
(function(){
  "use strict";

  /* =========================================================
     STATE & CONSTANTS
  ========================================================= */
  var LS_SETTINGS = "lw_settings_v4";
  var LS_CACHE = "lw_cache_v1";
  var LS_LAYOUT = "lw_layout_v1";
  var SYNC_DEBOUNCE_MS = 60000;
  var CACHE_DEBOUNCE_MS = 400;

  var PUBLIC_GIST_ID = (document.querySelector('meta[name="gist-public-id"]')?.content || "");

  var DEFAULT_PG_CODE = [
    "const { useState, useEffect, useRef, useMemo, useCallback } = React;",
    "",
    "function App() {",
    "  const [count, setCount] = useState(0);",
    "  const renders = useRef(0);",
    "  renders.current++;",
    "",
    "  useEffect(() => {",
    "    console.log('Count cambiato:', count);",
    "  }, [count]);",
    "",
    "  const doubled = useMemo(() => count * 2, [count]);",
    "  const increment = useCallback(() => setCount(c => c + 1), []);",
    "",
    "  return (",
    "    <div style={{ fontFamily: 'sans-serif', padding: 24, color: '#e6edf3' }}>",
    "      <h2>Playground pronto ✌️</h2>",
    "      <p>Count: {count} (doppio: {doubled})</p>",
    "      <button onClick={increment} style={{ padding: '8px 14px', cursor: 'pointer' }}>+1</button>",
    "      <p style={{ marginTop: 12, fontSize: 12, color: '#8b96a3' }}>Render #{renders.current}</p>",
    "    </div>",
    "  );",
    "}",
    "",
    "ReactDOM.createRoot(document.getElementById('root')).render(<App />);",
    ""
  ].join("\n");

  var state = {
    wiki: { categories: [], files: [] },
    playground: { code: DEFAULT_PG_CODE, updatedAt: 0 }
  };

  var settings = { githubToken: "", gistId: "" };
  var activeFileId = null;
  var isEditingFile = false;
  var syncTimer = null;
  var cacheTimer = null;
  var remoteSyncBlockedUntil = 0;
  var cm = null;
  var lastSyncError = "";
  var collapsedCategories = {};
  var isAdminMode = false;
  var titleDebounceTimer = null;

  /* =========================================================
   ADMIN MODE
========================================================= */
  // Aggiungi questa sezione intera prima di INIT

  function detectAdminMode(){
    // attivazione via ?admin=1 nell'URL
    if(/[?&]admin=1/.test(window.location.search)) return true;
    // oppure se ha già un token salvato in localStorage
    if(settings.githubToken) return true;
    return false;
  }

  function setAdminMode(on){
    isAdminMode = on;
    document.body.classList.toggle("viewer-mode", !on);
    var sw = document.getElementById("mode-switch");
    if(!sw) return;
    sw.classList.toggle("admin", on);
    sw.classList.toggle("viewer", !on);
    Array.prototype.forEach.call(sw.querySelectorAll(".mode-opt"), function(btn){
      var active = (btn.getAttribute("data-mode") === "admin") === on;
      btn.classList.toggle("active", active);
      btn.setAttribute("aria-pressed", active ? "true" : "false");
    });
  }


  document.getElementById("mode-switch").addEventListener("click", function(e){
    var btn = e.target.closest(".mode-opt");
    if(!btn) return;
    var wantAdmin = btn.getAttribute("data-mode") === "admin";
    if(wantAdmin === isAdminMode) return;

    if(wantAdmin){
      // Viewer → Admin: serve il token, setAdminMode(true) avviene
      // nel flusso di btn-save-settings dopo il pull riuscito
      openSettings();
    } else {
      if(!confirm("Uscire dalla modalità Admin e tornare a Viewer?")) return;
      settings.githubToken = "";
      saveSettingsLocal();
      setAdminMode(false);
      refreshSyncStatusIdle();
    }
  });

  /* =========================================================
     STORAGE HELPERS
  ========================================================= */
  function loadSettings(){
    try{
      var raw = localStorage.getItem(LS_SETTINGS);
      if(raw) settings = JSON.parse(raw);
    }catch(e){}
  }
  function saveSettingsLocal(){ localStorage.setItem(LS_SETTINGS, JSON.stringify(settings)); }
  function loadCache(){
    try{
      var raw = localStorage.getItem(LS_CACHE);
      if(raw){
        var parsed = JSON.parse(raw);
        if(parsed.wiki) state.wiki = parsed.wiki;
        if(parsed.playground) state.playground = parsed.playground;
      }
    }catch(e){}
  }
  function saveCache(){
    localStorage.setItem(LS_CACHE, JSON.stringify(state));
  }

  function scheduleCacheSave(){
    if(cacheTimer) clearTimeout(cacheTimer);

    cacheTimer = setTimeout(function(){
      cacheTimer = null;
      saveCache();
    }, CACHE_DEBOUNCE_MS);
  }

  window.addEventListener("pagehide", function(){
    if(cacheTimer){
      clearTimeout(cacheTimer);
      cacheTimer = null;
      saveCache();
    }
  });
  function uid(){ return Date.now().toString(36) + Math.random().toString(36).slice(2,8); }

  /* =========================================================
     SYNC (GitHub Gist)
  ========================================================= */
  var GIST_API = "https://api.github.com/gists";
  var GIST_FILENAME = "learning-wiki-data.json";
  function isConfigured(){ return !!(settings.githubToken && settings.gistId); }

  // Estrae un messaggio d'errore leggibile dalla risposta di GitHub
  function extractHttpError(res){
    return res.text().then(function(text){
      var detail = "";
      try{
        var json = JSON.parse(text);
        detail = json.message || "";
        if(json.errors && json.errors.length){
          detail += " (" + json.errors.map(function(e){
            return e.message || (e.field + " " + e.code);
          }).join("; ") + ")";
        }
      }catch(e){}
      var msg = "HTTP " + res.status + (res.statusText ? " " + res.statusText : "");
      if(detail) msg += " – " + detail;
      return new Error(msg);
    });
  }
  // Aggiungi: lettura pubblica senza token (per viewer mode)
  function pullPublic(){
    var gistId = settings.gistId || PUBLIC_GIST_ID;
    if(!gistId) return Promise.resolve(false);
    setSyncStatus("syncing", "caricamento...");
    return fetch(GIST_API + "/" + gistId)   // nessun Authorization header
            .then(function(res){
              if(!res.ok) throw new Error("HTTP " + res.status);
              return res.json();
            }).then(function(data){
              var file = data && data.files && data.files[GIST_FILENAME];
              if(!file) throw new Error("File non trovato nel gist");
              var contentPromise = file.truncated
                      ? fetch(file.raw_url).then(function(r){ return r.text(); })
                      : Promise.resolve(file.content);
              return contentPromise.then(function(text){
                var parsed = JSON.parse(text || "{}");
                if(parsed && parsed.wiki){
                  state.wiki = parsed.wiki;
                  state.playground = parsed.playground || state.playground;
                  saveCache();
                }
                setSyncStatus("synced", "sincronizzato");
                return true;
              });
            }).catch(function(err){
              console.warn("Pull pubblico fallito:", err);
              setSyncStatus("error", "errore caricamento");
              return false;
            });
  }

  function setSyncStatus(status, text, detail){
    var el = document.getElementById("sync-status");
    el.className = "status-" + status;
    document.getElementById("sync-status-text").textContent = text;
    el.title = detail || "Apri impostazioni sincronizzazione";
  }
  function refreshSyncStatusIdle(){
    if(!isConfigured()) setSyncStatus("idle", "non configurato");
    else setSyncStatus("synced", "sincronizzato");
  }

  function ghHeaders(extra){
    var h = {
      "Accept": "application/vnd.github+json",
      "Authorization": "token " + settings.githubToken
    };
    if(extra) for(var k in extra) h[k] = extra[k];
    return h;
  }

  function parseGistId(input){
    input = (input || "").trim();
    if(!input) return null;
    input = input.split("?")[0].split("#")[0];
    var parts = input.split("/").filter(Boolean);
    var last = parts[parts.length - 1] || input;
    if(/^[0-9a-f]{10,40}$/i.test(last)) return last;
    return null;
  }

  function pullFromRemote(){
    if(!isConfigured()) return Promise.resolve(false);
    setSyncStatus("syncing", "sincronizzazione...");
    return fetch(GIST_API + "/" + settings.gistId, { headers: ghHeaders() })
            .then(function(res){
              if(!res.ok) return extractHttpError(res).then(function(err){ throw err; });
              return res.json();
            }).then(function(data){
      var file = data && data.files && data.files[GIST_FILENAME];
      if(!file) throw new Error("File non trovato nel gist");
      var contentPromise = file.truncated
        ? fetch(file.raw_url).then(function(r){ return r.text(); })
        : Promise.resolve(file.content);
      return contentPromise.then(function(text){
        var parsed = JSON.parse(text || "{}");
        if(parsed && parsed.wiki){
          state.wiki = parsed.wiki;
          state.playground = parsed.playground || state.playground;
          saveCache();
        }
        setSyncStatus("synced", "sincronizzato");
        return true;
      });
            }).catch(function(err){
              console.warn("Pull gist fallito:", err);
              setSyncStatus("error", "errore lettura", err.message);
              lastSyncError = err.message;
              return false;
            });
  }

  function pushToRemote(){
    if(!isConfigured()) return Promise.resolve(false);

    if(Date.now() < remoteSyncBlockedUntil){
      var remainingMinutes = Math.ceil(
              (remoteSyncBlockedUntil - Date.now()) / 60000
      );

      setSyncStatus(
              "error",
              "limite GitHub raggiunto",
              "Nuovo tentativo tra circa " + remainingMinutes + " minuti."
      );

      return Promise.resolve(false);
    }

    setSyncStatus("syncing", "salvataggio...");

    var body = { files: {} };
    body.files[GIST_FILENAME] = { content: JSON.stringify(state) };

    return fetch(GIST_API + "/" + settings.gistId, {
      method: "PATCH",
      headers: ghHeaders({ "Content-Type": "application/json" }),
      body: JSON.stringify(body)
    }).then(function(res){
      if(!res.ok){
        var remaining = res.headers.get("X-RateLimit-Remaining");
        var reset = res.headers.get("X-RateLimit-Reset");

        if(res.status === 403 && remaining === "0"){
          var resetTime = reset ? Number(reset) * 1000 : Date.now() + 3600000;

          // Aggiunge un minuto di margine per evitare un nuovo 403
          remoteSyncBlockedUntil = resetTime + 60000;
        }

        return extractHttpError(res).then(function(err){
          throw err;
        });
      }

      lastSyncError = "";
      setSyncStatus("synced", "sincronizzato");
      return true;
    }).catch(function(err){
      console.warn("Push gist fallito:", err);

      setSyncStatus(
              "error",
              remoteSyncBlockedUntil > Date.now()
                      ? "limite GitHub raggiunto"
                      : "errore salvataggio",
              err.message
      );

      lastSyncError = err.message;
      return false;
    });
  }

  function createRemoteItem(){
    setSyncStatus("syncing", "creazione...");
    var body = { description: "Learning Wiki - dati sincronizzati", public: false, files: {} };
    body.files[GIST_FILENAME] = { content: JSON.stringify(state) };
    return fetch(GIST_API, {
      method: "POST",
      headers: ghHeaders({ "Content-Type": "application/json" }),
      body: JSON.stringify(body)
    }).then(function(res){
      if(!res.ok) return extractHttpError(res).then(function(err){ throw err; });
      return res.json();
    }).then(function(data){
      if(!data || !data.id) throw new Error("Risposta inattesa dal server");
      settings.gistId = data.id;
      saveSettingsLocal();
      setSyncStatus("synced", "sincronizzato");
      return true;
    }).catch(function(err){
      console.warn("Creazione gist fallita:", err);
      setSyncStatus("error", "errore creazione", err.message);
      lastSyncError = err.message;
      return false;
    });
  }

  function scheduleSync(){
    scheduleCacheSave();

    if(!isConfigured()){
      setSyncStatus("idle", "non configurato");
      return;
    }

    if(Date.now() < remoteSyncBlockedUntil){
      var remainingMinutes = Math.ceil(
              (remoteSyncBlockedUntil - Date.now()) / 60000
      );

      setSyncStatus(
              "error",
              "limite GitHub raggiunto",
              "Nuovo tentativo tra circa " + remainingMinutes + " minuti."
      );

      return;
    }

    setSyncStatus("syncing", "in attesa...");

    if(syncTimer) clearTimeout(syncTimer);

    syncTimer = setTimeout(function(){
      syncTimer = null;
      pushToRemote();
    }, SYNC_DEBOUNCE_MS);
  }

  /* =========================================================
     MARKDOWN RENDERING
  ========================================================= */
  marked.setOptions({
    highlight: function(code, lang){
      codeRegistry.push({ code: code, lang: (lang || "").toLowerCase() });
      try{
        if(lang && hljs.getLanguage(lang)) return hljs.highlight(code, {language: lang}).value;
        return hljs.highlightAuto(code).value;
      }catch(e){ return code; }
    },
    breaks: true
  });
  var codeRegistry = [];
  var RUNNABLE_LANGS = ["jsx","js","javascript","react"];

  function renderMarkdown(mdText){
    codeRegistry = [];
    var rawHtml = marked.parse(mdText || "");
    document.getElementById("md-viewer").innerHTML = DOMPurify.sanitize(rawHtml);
    attachTryExampleButtons();
  }

  function copyExampleCode(code, btn){
    function setCopiedState(){
      btn.classList.add("copied");
      btn.setAttribute("aria-label", "Codice copiato");
      btn.innerHTML = '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg><span class="btn-text">Copiato</span>';

      setTimeout(function(){
        btn.classList.remove("copied");
        btn.setAttribute("aria-label", "Copia codice");
        btn.innerHTML = '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg><span class="btn-text">Copia</span>';
      }, 1800);
    }

    if(navigator.clipboard && window.isSecureContext){
      navigator.clipboard.writeText(code).then(setCopiedState).catch(function(){});
      return;
    }

    var textarea = document.createElement("textarea");
    textarea.value = code;
    textarea.setAttribute("readonly", "");
    textarea.style.position = "fixed";
    textarea.style.opacity = "0";
    document.body.appendChild(textarea);
    textarea.select();
    document.execCommand("copy");
    document.body.removeChild(textarea);
    setCopiedState();
  }

  function addLineNumbers(codeEl){
    var lines = codeEl.innerHTML.split("\n");
    codeEl.innerHTML = lines.map(function(line){
      return '<span class="code-line">' + (line || "&nbsp;") + "</span>";
    }).join("");
  }

  function attachTryExampleButtons(){
    var blocks = document.querySelectorAll("#md-viewer pre code");
    blocks.forEach(function(codeEl, i){
      var entry = codeRegistry[i];
      if(!entry) return;
      var pre = codeEl.parentElement;
      if(RUNNABLE_LANGS.indexOf(entry.lang) === -1) return;

      addLineNumbers(codeEl);

      var wrap = document.createElement("div");
      wrap.className = "code-example-wrap";

      var header = document.createElement("div");
      header.className = "code-example-header";

      var meta = document.createElement("div");
      meta.className = "code-example-meta";

      var label = document.createElement("span");
      label.className = "lang-label";
      label.textContent = entry.lang || "code";

      var kind = document.createElement("span");
      kind.className = "example-kind";
      kind.textContent = "Esempio interattivo";

      var actions = document.createElement("div");
      actions.className = "code-example-actions";

      var copyBtn = document.createElement("button");
      copyBtn.type = "button";
      copyBtn.className = "copy-example-btn";
      copyBtn.setAttribute("aria-label", "Copia codice");
      copyBtn.innerHTML = '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg><span class="btn-text">Copia</span>';
      copyBtn.addEventListener("click", function(){
        copyExampleCode(entry.code, copyBtn);
      });

      var tryBtn = document.createElement("button");
      tryBtn.type = "button";
      tryBtn.className = "try-example-btn";
      tryBtn.innerHTML = '<svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor" aria-hidden="true"><polygon points="6 4 19 12 6 20"/></svg><span class="btn-text">Apri nel Playground</span>';
      tryBtn.addEventListener("click", function(){
        loadIntoPlayground(entry.code);
      });

      meta.appendChild(label);
      meta.appendChild(kind);
      actions.appendChild(copyBtn);
      actions.appendChild(tryBtn);
      header.appendChild(meta);
      header.appendChild(actions);

      pre.parentNode.insertBefore(wrap, pre);
      wrap.appendChild(header);
      wrap.appendChild(pre);
    });
  }

  function loadIntoPlayground(code){
    if(!cm) return;
    cm.setValue(code);
    state.playground.code = code;
    state.playground.updatedAt = Date.now();
    scheduleSync();
    showMobilePanel("playground");
    runPlayground();
    var pg = document.getElementById("playground-panel");
    pg.classList.add("flash");
    setTimeout(function(){ pg.classList.remove("flash"); }, 700);
  }

  /* =========================================================
     SIDEBAR RENDERING
  ========================================================= */

  function updateActiveTitleInSidebar(newTitle){
    var item = document.querySelector(".file-item.active .fname");
    if(item) item.textContent = newTitle;
  }

  function updateCategoryCount(cat){
    var heads = document.querySelectorAll(".category-head");
    heads.forEach(function(head){
      var nameSpan = head.querySelectorAll("span")[1]; // secondo span = nome categoria
      if(nameSpan && nameSpan.textContent === cat){
        var countEl = head.querySelector(".count");
        if(countEl) countEl.textContent = getFilesByCategory(cat).length;
      }
    });
  }
  function getFilesByCategory(cat){
    var q = (document.getElementById("wiki-search-input").value || "").toLowerCase().trim();
    return state.wiki.files.filter(function(f){
      if(f.category !== cat) return false;
      if(q && f.title.toLowerCase().indexOf(q) === -1) return false;
      return true;
    });
  }

  function appendSidebarFileItem(file, container, showCategory){
    var item = document.createElement("div");
    item.className = "file-item" + (file.id === activeFileId ? " active" : "");
    item.innerHTML =
            '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>' +
            '<span class="fname">' + escapeHtml(file.title) + '</span>' +
            (showCategory ? '<span class="file-category">' + escapeHtml(file.category) + '</span>' : '');

    item.addEventListener("click", function(){
      openFile(file.id);
      closeMobileSidebar();
      showMobilePanel("doc");
    });

    container.appendChild(item);
  }

  function renderSidebar(){
    var list = document.getElementById("category-list");
    var q = (document.getElementById("wiki-search-input").value || "").toLowerCase().trim();
    var recentFiles = state.wiki.files
            .filter(function(file){
              return file.recentlyOpenedAt &&
                      (!q || file.title.toLowerCase().indexOf(q) !== -1);
            })
            .sort(function(a, b){ return b.recentlyOpenedAt - a.recentlyOpenedAt; })
            .slice(0, 2);

    list.innerHTML = "";

    if(recentFiles.length){
      var recentBlock = document.createElement("div");
      recentBlock.className = "recent-block";
      recentBlock.innerHTML =
              '<div class="category-head">' +
              '<svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8"/><polyline points="12 8 12 12 15 14"/></svg>' +
              '<span>Recenti</span>' +
              '</div>';

      var recentList = document.createElement("div");
      recentList.className = "recent-files";
      recentFiles.forEach(function(file){
        appendSidebarFileItem(file, recentList, true);
      });

      recentBlock.appendChild(recentList);
      list.appendChild(recentBlock);
    }

    state.wiki.categories.forEach(function(cat){
      var block = document.createElement("div");
      block.className = "category-block";

      var head = document.createElement("div");
      head.className = "category-head" + (collapsedCategories[cat] !== false ? " collapsed" : "");

      var files = getFilesByCategory(cat);
      head.innerHTML = '<span class="chev">▾</span>' +
              '<svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>' +
              '<span>' + escapeHtml(cat) +
              '</span><span class="count">' + files.length + '</span><span class="del-cat" title="Elimina categoria"><svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="4" y1="4" x2="14" y2="14"/><line x1="14" y1="4" x2="4" y2="14"/></svg></span>';

      head.addEventListener("click", function(e){
        if(e.target.closest(".del-cat")){
          e.stopPropagation();
          deleteCategory(cat);
          return;
        }

        // aperto sse === false; qualsiasi altro valore (incluso undefined) è "chiuso"
        var isOpen = collapsedCategories[cat] === false;
        collapsedCategories[cat] = isOpen ? true : false;
        renderSidebar();
      });

      block.appendChild(head);

      if(collapsedCategories[cat] === false){
        var fileList = document.createElement("div");
        fileList.className = "file-list";

        files.forEach(function(file){
          appendSidebarFileItem(file, fileList, false);
        });

        block.appendChild(fileList);
      }

      list.appendChild(block);
    });

    renderCategorySelect();
  }

  function renderCategorySelect(){
    var dropdown = document.getElementById("category-dropdown");
    var label = document.getElementById("category-label");
    var toggle = document.getElementById("btn-category-toggle");
    var activeFile = getActiveFile();
    var selectedCategory = activeFile ? activeFile.category : "";

    label.textContent = selectedCategory || "Categoria";
    toggle.disabled = state.wiki.categories.length === 0;
    dropdown.innerHTML = "";

    state.wiki.categories.forEach(function(cat){
      var option = document.createElement("button");
      var isSelected = cat === selectedCategory;

      option.type = "button";
      option.className = "category-option" + (isSelected ? " selected" : "");
      option.setAttribute("role", "option");
      option.setAttribute("aria-selected", isSelected ? "true" : "false");
      option.setAttribute("data-category", cat);

      var name = document.createElement("span");
      name.className = "option-name";
      name.textContent = cat;
      option.appendChild(name);

      if(isSelected){
        var check = document.createElement("span");
        check.className = "check";
        check.innerHTML = '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="5 12 10 17 19 7"/></svg>';
        option.appendChild(check);
      }

