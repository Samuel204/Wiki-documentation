  /* ---- Ghost text inline (suggerimento grigio accanto al cursore) ---- */
  var ghostWidget = null;   // elemento DOM del suggerimento
  var ghostBookmark = null; // marker CodeMirror che tiene la posizione
  var ghostSuffix = "";     // testo da inserire se si preme Tab

  function clearGhost(){
    if(ghostBookmark){ ghostBookmark.clear(); ghostBookmark = null; }
    ghostWidget = null;
    ghostSuffix = "";
  }

  // Trova la parola suggerita in base a quanto digitato
  function findMatchingSuffix(candidates, typed){
    for(var i = 0; i < candidates.length; i++){
      var word = candidates[i];

      if(word !== typed && word.indexOf(typed) === 0){
        return word.slice(typed.length);
      }
    }

    return null;
  }

// Trova la parola suggerita in base al testo digitato e al contesto
  function findGhostSuffix(editor){
    var cur = editor.getCursor();
    var token = editor.getTokenAt(cur);
    var typed = token.string.slice(0, cur.ch - token.start);

    // Il suggerimento viene mostrato solo per identificatori validi
    if(!/^[A-Za-z_$][\w$]*$/.test(typed)) return null;

    var line = editor.getLine(cur.line);
    var beforeCursor = line.slice(0, cur.ch);

    // Riconosce contesti semplici come:
    // document.ge
    // window.set
    // element.inn
    // React.cre
    var contextMatch = beforeCursor.match(
            /(?:^|[^A-Za-z0-9_$])([A-Za-z_$][\w$]*)\.$/
    );

    if(contextMatch){
      var contextWords = PG_CONTEXT_WORDS[contextMatch[1]];

      if(contextWords){
        return findMatchingSuffix(contextWords, typed);
      }
    }

    // Fallback: parole predefinite + identificatori già presenti nel codice
    var candidates = PG_BASE_WORDS.slice();
    var text = editor.getValue();
    var re = /[A-Za-z_$][\w$]*/g;
    var match;
    var seen = {};

    candidates.forEach(function(word){
      seen[word] = true;
    });

    while((match = re.exec(text))){
      if(!seen[match[0]]){
        seen[match[0]] = true;
        candidates.push(match[0]);
      }
    }

    return findMatchingSuffix(candidates, typed);
  }

  function showGhost(editor){
    clearGhost();
    if(editor.somethingSelected()) return;

    var suffix = findGhostSuffix(editor);
    if(!suffix) return;

    ghostSuffix = suffix;
    var span = document.createElement("span");
    span.className = "pg-ghost-text";
    span.textContent = suffix;
    ghostWidget = span;

    // ancora il widget alla posizione del cursore
    ghostBookmark = editor.setBookmark(editor.getCursor(), {
      widget: span,
      insertLeft: false
    });
  }

  function acceptGhost(editor){
    if(!ghostSuffix) return CodeMirror.Pass;   // lascia agire il Tab normale
    var suffix = ghostSuffix;
    clearGhost();
    editor.replaceSelection(suffix);
    return true;
  }

  function initPlayground(){
    cm = CodeMirror.fromTextArea(document.getElementById("pg-textarea"), {
      mode: "jsx",
      theme: "material-darker",
      lineNumbers: true,
      tabSize: 2,
      indentUnit: 2,
      autoCloseBrackets: true,
      matchBrackets: true,
      viewportMargin: Infinity,
      extraKeys: {
        "Tab": function(editor){ return acceptGhost(editor); },
        "Right": function(editor){ return acceptGhost(editor); }
      }
    });
    cm.setValue(state.playground.code || DEFAULT_PG_CODE);

    // mostra il ghost text mentre si digita un identificatore
    cm.on("inputRead", function(editor, change){
      if(change.text && /[\w$]$/.test(change.text.join(""))){
        showGhost(editor);
      } else {
        clearGhost();
      }
    });

    // nascondi il ghost quando il cursore si muove o si clicca
    cm.on("cursorActivity", function(editor){
      // se il cursore non è più dove sta il ghost, puliscilo
      if(ghostBookmark){
        var pos = ghostBookmark.find();
        var cur = editor.getCursor();
        if(!pos || pos.line !== cur.line || pos.ch !== cur.ch){
          clearGhost();
        }
      }
    });

    var debounceTimer = null;
    cm.on("change", function(){
      state.playground.code = cm.getValue();
      state.playground.updatedAt = Date.now();
      document.getElementById("pg-autosave").textContent = "modifiche non salvate...";
      if(debounceTimer) clearTimeout(debounceTimer);
      debounceTimer = setTimeout(function(){
        scheduleSync();
        document.getElementById("pg-autosave").textContent = "salvato · " + new Date().toLocaleTimeString();
      }, 900);
    });
  }

  function buildIframeDoc(userCode){
    return `<!DOCTYPE html><html><head><meta charset='utf-8'>
              <meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'unsafe-inline' 'unsafe-eval' https://cdnjs.cloudflare.com; style-src 'unsafe-inline'; connect-src https://cdnjs.cloudflare.com;">
              <style>body{margin:0;font-family:sans-serif;color:#e6edf3;background:#0d1117;} #err-overlay{position:fixed;inset:0;background:#2a1214;color:#ff9b93;padding:16px;font-family:monospace;font-size:12px;white-space:pre-wrap;overflow:auto;display:none;}</style>
              <script src='https://cdnjs.cloudflare.com/ajax/libs/react/18.2.0/umd/react.production.min.js'><\/script>
          <script src='https://cdnjs.cloudflare.com/ajax/libs/react-dom/18.2.0/umd/react-dom.production.min.js'><\/script>
          <script src='https://cdnjs.cloudflare.com/ajax/libs/babel-standalone/7.23.5/babel.min.js'><\/script>
          </head><body>
      <div id='root'></div>
      <div id='err-overlay'></div>
      <script>
      (function(){
        function serialize(args){
          return Array.prototype.map.call(args, function(a){
            if(typeof a === 'string') return a;
            try { return JSON.stringify(a); } catch(e){ return String(a); }
          }).join(' ');
        }
        ['log','info','warn','error'].forEach(function(level){
          var orig = console[level];
          console[level] = function(){
            parent.postMessage({ __pg: true, type: (level === 'error' || level === 'warn') ? 'error' : 'log', message: serialize(arguments) }, '*');
            if(orig) orig.apply(console, arguments);
          };
        });
      })();
      <\/script>
      <script>
      window.onerror = function(msg, source, lineno, colno, error){
        var detail = (error && error.stack) ? error.stack : msg;
        showError(detail, lineno, colno);
        return true;
      };
      window.addEventListener('unhandledrejection', function(ev){
        var r = ev.reason;
        showError('Promise non gestita: ' + ((r && r.stack) || r), null, null);
      });
      function showError(msg, lineno, colno){
        var pos = (lineno != null) ? (' (riga ' + lineno + (colno != null ? ', col ' + colno : '') + ')') : '';
        var o = document.getElementById('err-overlay');
        o.style.display='block'; o.textContent = 'Errore' + pos + ':\\n' + msg;
        parent.postMessage({ __pg: true, type: 'error', message: String(msg), line: lineno, col: colno }, '*');
      }
      <\/script>
      <script>
      (function(){
        try {
          var compiled = Babel.transform(
            ${JSON.stringify(userCode)},
            { presets: ['react'], filename: 'playground.jsx' }
          ).code;
          var fn = new Function(compiled);
          fn();
        } catch(e) {
          var loc = (e.loc ? (' (riga ' + e.loc.line + ', col ' + e.loc.column + ')') : '');
          showError((e.message || String(e)) + loc, e.loc && e.loc.line, e.loc && e.loc.column);
        }
      })();
      <\/script>
      </body></html>`;
  }

  function runPlayground(){
    var code = cm.getValue();
    document.getElementById("pg-iframe").srcdoc = buildIframeDoc(code);
    document.getElementById("pg-console").classList.add("visible");
    logToConsole("▶ Esecuzione avviata", false);
  }

  function resetPlayground(){
    if(!confirm("Ripristinare il codice di default? Le modifiche correnti andranno perse.")) return;
    cm.setValue(DEFAULT_PG_CODE);
    state.playground.code = DEFAULT_PG_CODE;
    scheduleSync();
  }

  function logToConsole(msg, isError){
    var box = document.getElementById("pg-console");
    var line = document.createElement("div");
    line.className = "log-line" + (isError ? " error" : "");
    line.textContent = msg;
    box.appendChild(line);
    box.scrollTop = box.scrollHeight;
  }

  window.addEventListener("message", function(e){
    var iframe = document.getElementById("pg-iframe");
    if(e.source !== iframe.contentWindow) return;
    var d = e.data;
    if(!d || !d.__pg) return;
    if(d.type === "error"){
      var where = (d.line != null) ? (" [riga " + d.line + (d.col != null ? ", col " + d.col : "") + "]") : "";
      logToConsole("✖ " + d.message + where, true);
    } else if(d.type === "log"){
      logToConsole(d.message, false);
    }
  });

  document.getElementById("btn-run").addEventListener("click", runPlayground);
  document.getElementById("btn-reset").addEventListener("click", resetPlayground);
  document.getElementById("btn-toggle-console").addEventListener("click", function(){
    var box = document.getElementById("pg-console");
    var willShow = !box.classList.contains("visible");
    box.classList.toggle("visible", willShow);
    if(willShow) box.innerHTML = "";
  });

  /* =========================================================
     SETTINGS MENU (dropdown) + EXPORT
  ========================================================= */
  function sanitizeFilename(name){
    return (name || "file").replace(/[\/\\?%*:|"<>]/g, "-").trim() || "file";
  }

  function downloadBlob(blob, filename){
    var url = URL.createObjectURL(blob);
    var a = document.createElement("a");
    a.href = url; a.download = filename;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    setTimeout(function(){ URL.revokeObjectURL(url); }, 1000);
  }

  function exportCurrentFile(){
    var file = getActiveFile();
    if(!file){ alert("Nessun file aperto da esportare."); return; }
    var blob = new Blob([file.content], { type: "text/markdown;charset=utf-8" });
    downloadBlob(blob, sanitizeFilename(file.title) + ".md");
  }

  function exportAllFiles(){
    if(!state.wiki.files.length){ alert("Non ci sono file da esportare."); return; }
    if(typeof JSZip === "undefined"){ alert("Libreria di export non disponibile (controlla la connessione)."); return; }
    var zip = new JSZip();
    state.wiki.files.forEach(function(f){
      var folder = sanitizeFilename(f.category || "Generale");
      var name = sanitizeFilename(f.title) + ".md";
      zip.folder(folder).file(name, f.content);
    });
    zip.generateAsync({ type: "blob" }).then(function(blob){
      var stamp = new Date().toISOString().slice(0,10);
      downloadBlob(blob, "learning-wiki-export-" + stamp + ".zip");
    });
  }

  document.getElementById("btn-export-all").addEventListener("click", exportAllFiles);
  document.getElementById("btn-export-current").addEventListener("click", exportCurrentFile);

  /* =========================================================
     SETTINGS MODAL
  ========================================================= */
  function openSettings(){
    document.getElementById("input-github-token").value = "";
    document.getElementById("input-gist-id").value = "";
    var msg = document.getElementById("settings-status-msg");
    if(lastSyncError){
      msg.style.color = "var(--danger)";
      msg.textContent = "Ultimo errore: " + lastSyncError;
    } else {
      msg.textContent = "";
    }
    document.getElementById("settings-modal").classList.add("visible");
  }
  function closeSettings(){ document.getElementById("settings-modal").classList.remove("visible"); }
  document.getElementById("btn-close-settings").addEventListener("click", closeSettings);

  document.getElementById("sync-status").addEventListener("click", openSettings);
  document.getElementById("sync-status").addEventListener("keydown", function(e){
    if(e.key === "Enter" || e.key === " "){
      e.preventDefault();
      openSettings();
    }
  });

  document.getElementById("btn-save-settings").addEventListener("click", function(){
    var msg = document.getElementById("settings-status-msg");
    var tokenVal = document.getElementById("input-github-token").value.trim();
    if(tokenVal && /^https?:\/\//i.test(tokenVal)){
      msg.style.color = "var(--danger)";
      msg.textContent = "Il campo Token contiene un URL, non un token. Incolla solo il token GitHub.";
      return;
    }
    // Se il campo è vuoto ma un token è già salvato, mantieni quello esistente
    if(tokenVal){
      settings.githubToken = tokenVal;
    } else if(!settings.githubToken){
      msg.style.color = "var(--danger)";
      msg.textContent = "Inserisci il GitHub Token.";
      return;
    }
    var gistId = parseGistId(document.getElementById("input-gist-id").value);
    if(!gistId){
      msg.style.color = "var(--danger)";
      msg.textContent = "Gist ID/URL non valido.";
      return;
    }
    settings.gistId = gistId;
    saveSettingsLocal();
    msg.style.color = "var(--text-dim)";
    msg.textContent = "Salvataggio... verifica connessione al Gist.";
    pullFromRemote().then(function(ok){
      if(ok){
        msg.style.color = "var(--ok)";
        msg.textContent = "Connesso! Dati caricati.";
        setAdminMode(true);   // ← aggiunto: aggiorna badge e mostra controlli
        renderSidebar();
        if(cm) cm.setValue(state.playground.code || DEFAULT_PG_CODE);
      } else {
        msg.style.color = "var(--danger)";
        msg.textContent = "Non riesco a leggere questo Gist. Controlla token/ID, oppure creane uno nuovo.";
      }
    });
  });

  document.getElementById("btn-init-bin").addEventListener("click", function(){
    var tokenVal = document.getElementById("input-github-token").value.trim();
    if(!tokenVal){
      document.getElementById("settings-status-msg").style.color = "var(--danger)";
      document.getElementById("settings-status-msg").textContent = "Inserisci prima il GitHub Token.";
      return;
    }
    settings.githubToken = tokenVal;
    saveSettingsLocal();
    var msg = document.getElementById("settings-status-msg");
    msg.style.color = "var(--text-dim)";
    msg.textContent = "Creazione nuovo Gist in corso...";
    createRemoteItem().then(function(ok){
      if(ok){
        document.getElementById("input-gist-id").value = settings.gistId;
        msg.style.color = "var(--ok)";
        msg.textContent = "Gist creato e collegato con lo stato corrente!";
      } else {
        msg.style.color = "var(--danger)";
        msg.textContent = "Errore durante la creazione del Gist. Il token ha lo scope \"gist\"?";
      }
    });
  });

  /* =========================================================
     INIT
  ========================================================= */
  function init(){
    loadSettings();
    loadCache();

    // Se non c'è un gistId salvato, usa quello pubblico hardcodato
    if(!settings.gistId && PUBLIC_GIST_ID) settings.gistId = PUBLIC_GIST_ID;

    isAdminMode = detectAdminMode();
    setAdminMode(isAdminMode);   // applica subito le classi CSS

    renderSidebar();
    if(state.wiki.files.length === 0) closeFilePanel();
    initPlayground();

    if(localStorage.getItem(LS_SIDEBAR) === "1" && !isMobileViewport()){
      document.getElementById("wiki-sidebar").classList.add("collapsed");
    }

    if(isAdminMode && isConfigured()){
      // admin con token → pull autenticato (come prima)
      pullFromRemote().then(function(){
        renderSidebar();
        if(cm) cm.setValue(state.playground.code || DEFAULT_PG_CODE);
      });
      refreshSyncStatusIdle();
    } else if(PUBLIC_GIST_ID){
      // viewer → pull pubblico senza token, NON apre il modal
      pullPublic().then(function(){
        renderSidebar();
        if(cm) cm.setValue(state.playground.code || DEFAULT_PG_CODE);
      });
    } else {
      // nessun gist configurato → apri settings (comportamento precedente)
      refreshSyncStatusIdle();
      setTimeout(openSettings, 400);
    }
  }

  document.addEventListener("DOMContentLoaded", init);
})();
</script>
